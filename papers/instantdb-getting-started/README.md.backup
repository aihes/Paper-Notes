## 6. 查询数据：InstaQL

### 6.1 基础查询

```javascript
// 获取所有待办事项
const { data, isLoading, error } = db.useQuery({ todos: {} });

if (isLoading) return <div>加载中...</div>;
if (error) return <div>错误：{error.message}</div>;

return (
  <ul>
    {data.todos.map(todo => (
      <li key={todo.id}>{todo.text}</li>
    ))}
  </ul>
);
```

### 6.2 查询关联数据

```javascript
// 获取目标及其关联的待办事项
const { data } = db.useQuery({
  goals: {
    todos: {}  // 嵌套查询
  }
});

data.goals.forEach(goal => {
  console.log(goal.title);
  goal.todos.forEach(todo => {
    console.log('  -', todo.text);
  });
});
```

### 6.3 过滤数据

```javascript
// 按 ID 过滤
const { data } = db.useQuery({
  todos: {
    $: {
      where: { id: 'specific-id' }
    }
  }
});

// 按属性过滤
const { data } = db.useQuery({
  todos: {
    $: {
      where: { completed: false }
    }
  }
});

// 按关联属性过滤
const { data } = db.useQuery({
  goals: {
    $: {
      where: { 'todos.completed': true }
    }
  }
});
```

### 6.4 高级过滤

```javascript
// 逻辑运算符
const { data } = db.useQuery({
  todos: {
    $: {
      where: {
        or: [
          { completed: true },
          { priority: { $gt: 5 } }
        ]
      }
    }
  }
});

// 比较运算符
const { data } = db.useQuery({
  todos: {
    $: {
      where: {
        createdAt: { $gte: Date.now() - 86400000 } // 最近 24 小时
      }
    }
  }
});

// 其他运算符
const operators = {
  $in: [1, 2, 3],        // 在列表中
  $ne: 'value',          // 不等于
  $isNull: true,         // 是否为空
  $like: '%pattern%',    // 模式匹配（区分大小写）
  $ilike: '%pattern%',   // 模式匹配（不区分大小写）
};
```

### 6.5 排序和分页

```javascript
// 排序
const { data } = db.useQuery({
  todos: {
    $: {
      where: { completed: false },
      order: { createdAt: 'desc' }
    }
  }
});

// 分页（offset-based）
const { data } = db.useQuery({
  todos: {
    $: {
      limit: 10,
      offset: 20  // 跳过前 20 条
    }
  }
});

// 游标分页（cursor-based）
const { data } = db.useQuery({
  todos: {
    $: {
      first: 10,
      after: 'cursor-token'
    }
  }
});
```

### 6.6 选择字段

```javascript
// 只返回特定字段
const { data } = db.useQuery({
  todos: {
    $: {
      fields: ['text', 'completed']
    }
  }
});
```

---

## 7. 写入数据

### 7.1 事务（Transactions）

InstantDB 使用事务来修改数据。事务是原子性的：要么全部成功，要么全部失败。

```javascript
import { tx, id } from '@instantdb/react';

// 添加新待办事项
db.transact(
  tx.todos[id()].update({
    text: '学习 InstantDB',
    completed: false,
    createdAt: Date.now(),
  })
);
```

### 7.2 更新数据

```javascript
// 更新现有数据
db.transact(
  tx.todos[todoId].update({
    completed: true
  })
);
```

### 7.3 删除数据

```javascript
// 删除数据
db.transact(
  tx.todos[todoId].delete()
);
```

### 7.4 批量操作

```javascript
// 一次性执行多个操作
db.transact([
  tx.todos[id1].update({ completed: true }),
  tx.todos[id2].update({ completed: true }),
  tx.todos[id3].delete(),
]);
```

### 7.5 关联数据

```javascript
// 创建关联
const goalId = id();
const todoId = id();

db.transact([
  tx.goals[goalId].update({
    title: '学习新技术',
  }),
  tx.todos[todoId].update({
    text: '阅读 InstantDB 文档',
    completed: false,
  }),
  tx.goals[goalId].link({ todos: todoId }),
]);
```

### 7.6 解除关联

```javascript
// 解除关联
db.transact(
  tx.goals[goalId].unlink({ todos: todoId })
);
```

---

## 8. 实战示例

### 8.1 完整的待办应用

```typescript
import { useState } from 'react';
import { tx, id } from '@instantdb/react';
import db from './db';

function TodoApp() {
  const [input, setInput] = useState('');
  const { data, isLoading } = db.useQuery({ todos: {} });

  // 添加待办
  const addTodo = () => {
    if (!input.trim()) return;

    db.transact(
      tx.todos[id()].update({
        text: input,
        completed: false,
        createdAt: Date.now(),
      })
    );

    setInput('');
  };

  // 切换完成状态
  const toggleTodo = (todo) => {
    db.transact(
      tx.todos[todo.id].update({
        completed: !todo.completed
      })
    );
  };

  // 删除待办
  const deleteTodo = (todoId) => {
    db.transact(
      tx.todos[todoId].delete()
    );
  };

  if (isLoading) return <div>加载中...</div>;

  return (
    <div>
      <h1>我的待办事项</h1>

      <div>
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyPress={(e) => e.key === 'Enter' && addTodo()}
          placeholder="添加新待办..."
        />
        <button onClick={addTodo}>添加</button>
      </div>

      <ul>
        {data.todos
          .sort((a, b) => b.createdAt - a.createdAt)
          .map(todo => (
            <li key={todo.id}>
              <input
                type="checkbox"
                checked={todo.completed}
                onChange={() => toggleTodo(todo)}
              />
              <span style={{
                textDecoration: todo.completed ? 'line-through' : 'none'
              }}>
                {todo.text}
              </span>
              <button onClick={() => deleteTodo(todo.id)}>删除</button>
            </li>
          ))}
      </ul>
    </div>
  );
}

export default TodoApp;
```

### 8.2 实时协作示例

```typescript
import { tx, id } from '@instantdb/react';
import db from './db';

function CollaborativeEditor() {
  const { data } = db.useQuery({
    documents: {
      users: {}  // 查询文档及其协作者
    }
  });

  // 显示在线用户
  const room = db.room('document-room');
  const presence = room.usePresence();

  return (
    <div>
      <div>
        在线用户：{Object.keys(presence.peers).length}
      </div>

      {/* 文档编辑器 */}
      <textarea
        onChange={(e) => {
          db.transact(
            tx.documents[docId].update({
              content: e.target.value,
              updatedAt: Date.now(),
            })
          );
        }}
      />
    </div>
  );
}
```

---

## 9. 最佳实践

### 9.1 Schema 设计

#### ✅ 推荐做法

```typescript
// 明确定义所有字段
todos: i.entity({
  text: i.string(),
  completed: i.boolean(),
  priority: i.number().indexed(), // 频繁查询的字段添加索引
  createdAt: i.number().indexed(),
})
```

#### ❌ 避免做法

```typescript
// 不要过度使用 i.any()
data: i.any(), // 失去类型安全
```

### 9.2 查询优化

#### ✅ 推荐做法

```javascript
// 只查询需要的字段
const { data } = db.useQuery({
  todos: {
    $: {
      fields: ['text', 'completed']
    }
  }
});

// 使用索引字段进行过滤和排序
const { data } = db.useQuery({
  todos: {
    $: {
      where: { createdAt: { $gte: timestamp } },
      order: { createdAt: 'desc' }
    }
  }
});
```

#### ❌ 避免做法

```javascript
// 不要一次性查询过多数据
const { data } = db.useQuery({
  todos: {},
  users: {},
  comments: {},
  posts: {}
});
```

### 9.3 环境分离

在开发和生产环境使用不同的 APP_ID：

```typescript
const APP_ID = process.env.NODE_ENV === 'production'
  ? 'prod-app-id'
  : 'dev-app-id';

const db = init({ appId: APP_ID });
```

### 9.4 权限配置

在生产环境锁定 schema：

```typescript
// 在 Instant Dashboard 中设置权限规则
// 防止客户端随意创建新的命名空间和属性
```

### 9.5 错误处理

```javascript
const { data, error, isLoading } = db.useQuery({ todos: {} });

if (error) {
  console.error('查询失败:', error);
  // 显示友好的错误信息给用户
  return <ErrorMessage error={error} />;
}
```

### 9.6 使用 TypeScript

```typescript
import { init } from '@instantdb/react';
import schema from './instant.schema';

// 带类型的 db 实例
const db = init({
  appId: APP_ID,
  schema
});

// 现在享受完整的类型提示
const { data } = db.useQuery({ todos: {} });
// data.todos 是类型安全的！
```

### 9.7 调试技巧

使用 Instant Dashboard 的 Sandbox 功能：
- 查看所有数据
- 测试查询
- 检查权限规则
- 查看权限检查日志

---

## 10. 总结

### InstantDB 的优势

1. **开发效率高**：5 分钟就能搭建实时应用
2. **本地优先**：即时响应，自动离线支持
3. **简单易用**：直观的 API，无需学习复杂的后端知识
4. **功能完整**：认证、权限、文件存储一应俱全
5. **TypeScript 友好**：完整的类型支持

### 适用场景

- 原型开发和 MVP
- 实时协作应用（文档编辑、白板等）
- 社交应用
- 待办和任务管理
- 数据看板和监控

### 不适用场景

- 需要复杂服务器端逻辑的应用
- 对数据库有特殊性能要求的大型应用
- 需要与现有后端深度集成的项目

### 下一步学习

- 探索 [官方文档](https://www.instantdb.com/docs)
- 尝试 [交互式教程](https://www.instantdb.com/tutorial)
- 查看 [GitHub 示例](https://github.com/instantdb/instant)
- 加入社区讨论

